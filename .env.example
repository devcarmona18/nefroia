# =============================================================================
# NefroIA - variables de entorno
# Copia este archivo a `.env` (Docker) o `.env.local` (desarrollo sin Docker)
# y completa los valores. Nunca subas archivos con secretos reales al repositorio.
# =============================================================================

# -----------------------------------------------------------------------------
# Aplicación y autenticación
# -----------------------------------------------------------------------------
# [OBLIGATORIA] Secreto para firmar las sesiones. Genera uno con:
#   openssl rand -base64 32
AUTH_SECRET=

# URL pública de la aplicación (se usa en metadatos, imágenes OG y cookies).
# Ejemplo en producción: https://nefroia.example.org
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# [Opcional] Prefijo de ruta si se sirve bajo un subdirectorio (p. ej. /nefroia).
# Se fija en tiempo de compilación.
# NEXT_PUBLIC_BASE_PATH=

# -----------------------------------------------------------------------------
# Integración con Hoja Diaria Renal (SSO + iframe). Ver docs/integracion-nefroia.md
# -----------------------------------------------------------------------------
# Secreto compartido con Hoja Diaria (MISMO valor en ambos, >= 32 caracteres).
# Vacío = /sso rechaza todo. Genera uno con: openssl rand -base64 48
NEFROIA_SSO_SECRET=
# Único origen autorizado a enmarcar NefroIA (CSP frame-ancestors). Activa las
# cookies SameSite=None; Secure (requiere HTTPS). Vacío = nadie puede enmarcarla.
# Ejemplo: https://hoja-diaria-renal.onrender.com
HOJA_DIARIA_ORIGIN=
# Mensajes por hora de los visitantes del modo demo de Hoja Diaria (sin subir
# protocolos ni archivos).
# RATE_LIMIT_SSO_DEMO_MESSAGES_PER_HOUR=5

# -----------------------------------------------------------------------------
# Proveedores de IA (llamadas directas, sin pasarelas intermedias)
# -----------------------------------------------------------------------------
# [OBLIGATORIA] Proveedor por defecto. https://console.anthropic.com/
ANTHROPIC_API_KEY=

# [Opcional] Si se define, se habilitan los modelos de OpenAI en el selector.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# [Opcional] Si se define, se habilitan los modelos de Google Gemini.
# https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# [Opcional] Modelo por defecto (formato proveedor/modelo, ver lib/ai/models.ts).
# AI_DEFAULT_MODEL=anthropic/claude-sonnet-4-5
# [Opcional] Modelo barato usado para generar los títulos de los chats.
# AI_TITLE_MODEL=anthropic/claude-haiku-4-5

# -----------------------------------------------------------------------------
# Base de datos (PostgreSQL 16)
# -----------------------------------------------------------------------------
# [OBLIGATORIA] Cadena de conexión. Con docker compose se sobrescribe sola.
# La imagen pgvector/pgvector:pg16 activa la búsqueda vectorial con HNSW; sin
# pgvector la app funciona igual con un ranking exacto sobre real[].
POSTGRES_URL=postgres://nefroia:nefroia@localhost:5432/nefroia
# Contraseña del Postgres de docker compose (cámbiala fuera de desarrollo).
POSTGRES_PASSWORD=nefroia

# -----------------------------------------------------------------------------
# Protocolos de la unidad (RAG): embeddings
# -----------------------------------------------------------------------------
# local  (por defecto) multilingual-e5-small en el servidor con
#        @huggingface/transformers. Descarga ~120 MB de huggingface.co la
#        primera vez; no envía los protocolos a terceros.
# openai text-embedding-3-small a 384 dimensiones (requiere OPENAI_API_KEY;
#        el texto de los protocolos se envía a OpenAI).
# hash   determinista y sin red, NO semántico: solo pruebas/CI o entornos
#        sin acceso al modelo. Es el valor por defecto con PLAYWRIGHT=True.
# Cambiar de proveedor obliga a volver a subir (reindexar) los protocolos.
# EMBEDDING_PROVIDER=local
# Carpeta de caché del modelo local (útil para precargarlo en la imagen).
# EMBEDDING_CACHE_DIR=/app/.cache/transformers

# -----------------------------------------------------------------------------
# Datos de demostración (pnpm db:seed)
# -----------------------------------------------------------------------------
# Usuario demo con tres protocolos de demostración y dos hojas de sesión.
# DEMO_USER_EMAIL=demo@nefroia.app
# DEMO_USER_PASSWORD=NefroIA-demo-2026

# -----------------------------------------------------------------------------
# Redis 7 (opcional pero recomendado)
# -----------------------------------------------------------------------------
# Habilita streams reanudables y límites de uso compartidos entre instancias.
# Sin Redis, los límites usan memoria del proceso y los streams no se reanudan.
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Almacenamiento de archivos compatible con S3 (AWS S3, MinIO, Cloudflare R2...)
# El bucket debe ser PRIVADO: los archivos se sirven con URLs prefirmadas.
# Sin S3_BUCKET la subida de adjuntos del chat queda deshabilitada; los
# protocolos se indexan igualmente, pero no se conserva el archivo original.
# -----------------------------------------------------------------------------
S3_BUCKET=nefroia-uploads
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=nefroia
S3_SECRET_ACCESS_KEY=nefroia-secret
# Solo para MinIO/R2/otros (déjalo vacío con AWS S3):
S3_ENDPOINT=http://localhost:9000
# Endpoint alcanzable desde el NAVEGADOR para las URLs prefirmadas
# (si la app lo alcanza por otro nombre, p. ej. minio:9000 dentro de Docker).
S3_PUBLIC_ENDPOINT=http://localhost:9000
# true para MinIO y la mayoría de servicios compatibles.
S3_FORCE_PATH_STYLE=true
# Credenciales de MinIO en docker compose (cámbialas fuera de desarrollo).
MINIO_ROOT_USER=nefroia
MINIO_ROOT_PASSWORD=nefroia-secret

# -----------------------------------------------------------------------------
# Límites de uso
# -----------------------------------------------------------------------------
# Mensajes por hora y usuario.
RATE_LIMIT_GUEST_MESSAGES_PER_HOUR=10
RATE_LIMIT_USER_MESSAGES_PER_HOUR=60
# Mensajes por hora y dirección IP (varias personas pueden compartir IP).
RATE_LIMIT_IP_MESSAGES_PER_HOUR=100
# Intentos de login/registro por correo (por IP: 5 veces este valor) y ventana.
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_MINUTES=15

# -----------------------------------------------------------------------------
# Observabilidad (opcional)
# -----------------------------------------------------------------------------
# Exportador OpenTelemetry OTLP/HTTP. Sin esta variable, la telemetría se omite.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=nefroia
